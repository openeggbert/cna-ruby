            def ToVector3: () -> Vector3
            def ToString: () -> String
            def GetHashCode: () -> Integer
            def Equals: (Object obj) -> bool
                      | (Bgr565 other) -> bool
            def ==: (Bgr565 other) -> bool
            def !=: (Bgr565 other) -> bool
            attr_accessor PackedValue: Integer
          end

