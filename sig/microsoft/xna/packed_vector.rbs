module Microsoft
  module Xna
    module Framework
      module Graphics
        module PackedVector
          module IPackedVector
            private
            def ToVector4: () -> Vector4
            def PackFromVector4: (Vector4 vector) -> nil
          end

          module IPackedVectorOfT[TPacked]
            include IPackedVector
            attr_accessor PackedValue: TPacked
          end

          class Alpha8
            include IPackedVectorOfT[Integer]
            def initialize: (Float alpha) -> void
            def ToAlpha: () -> Float
            def ToString: () -> String
            def GetHashCode: () -> Integer
            def Equals: (Object obj) -> bool
                      | (Alpha8 other) -> bool
            def ==: (Alpha8 other) -> bool
            def !=: (Alpha8 other) -> bool
            attr_accessor PackedValue: Integer
          end

          class Bgr565
            include IPackedVectorOfT[Integer]
            def initialize: (Float x, Float y, Float z) -> void
