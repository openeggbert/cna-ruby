                        | (BoundingBox box) -> PlaneIntersectionType
                        | (BoundingFrustum frustum) -> PlaneIntersectionType
                        | (BoundingSphere sphere) -> PlaneIntersectionType
                        | (BoundingSphere sphere) -> PlaneIntersectionType
        def ==: (Plane rhs) -> bool
        def !=: (Plane rhs) -> bool
      end

      class Ray
        attr_accessor Position: Vector3
        attr_accessor Direction: Vector3
        def initialize: (Vector3 position, Vector3 direction) -> void
        def Equals: (Ray other) -> bool
                    | (Object obj) -> bool
        def GetHashCode: () -> Integer
        def ToString: () -> String
        def Intersects: (BoundingBox box) -> Float?
                        | (BoundingBox box) -> Float?
                        | (BoundingFrustum frustum) -> Float?
                        | (Plane plane) -> Float?
                        | (Plane plane) -> Float?
                        | (BoundingSphere sphere) -> Float?
                        | (BoundingSphere sphere) -> Float?
        def ==: (Ray b) -> bool
        def !=: (Ray b) -> bool
      end

      class BoundingBox
        CornerCount: Integer
        attr_accessor Min: Vector3
        attr_accessor Max: Vector3
        def initialize: (Vector3 min, Vector3 max) -> void
        def GetCorners: () -> Array[Vector3]
                        | (Array[Vector3] corners) -> nil
        def Equals: (BoundingBox other) -> bool
                    | (Object obj) -> bool
        def GetHashCode: () -> Integer
        def ToString: () -> String
        def self.CreateMerged: (BoundingBox original, BoundingBox additional) -> BoundingBox
                               | (BoundingBox original, BoundingBox additional) -> BoundingBox
        def self.CreateFromSphere: (BoundingSphere sphere) -> BoundingBox
                                   | (BoundingSphere sphere) -> BoundingBox
        def self.CreateFromPoints: (Enumerable[Vector3] points) -> BoundingBox
        def Intersects: (BoundingBox box) -> bool
                        | (BoundingBox box) -> bool
                        | (BoundingFrustum frustum) -> bool
                        | (Plane plane) -> PlaneIntersectionType
                        | (Plane plane) -> PlaneIntersectionType
                        | (Ray ray) -> Float?
                        | (Ray ray) -> Float?
                        | (BoundingSphere sphere) -> bool
                        | (BoundingSphere sphere) -> bool
        def Contains: (BoundingBox box) -> ContainmentType
                      | (BoundingBox box) -> ContainmentType
                      | (BoundingFrustum frustum) -> ContainmentType
                      | (Vector3 point) -> ContainmentType
                      | (Vector3 point) -> ContainmentType
                      | (BoundingSphere sphere) -> ContainmentType
                      | (BoundingSphere sphere) -> ContainmentType
        def ==: (BoundingBox b) -> bool
        def !=: (BoundingBox b) -> bool
      end

      class BoundingSphere
        attr_accessor Center: Vector3
        attr_accessor Radius: Float
        def initialize: (Vector3 center, Float radius) -> void
        def Equals: (BoundingSphere other) -> bool
                    | (Object obj) -> bool
        def GetHashCode: () -> Integer
        def ToString: () -> String
        def self.CreateMerged: (BoundingSphere original, BoundingSphere additional) -> BoundingSphere
                               | (BoundingSphere original, BoundingSphere additional) -> BoundingSphere
        def self.CreateFromBoundingBox: (BoundingBox box) -> BoundingSphere
                                        | (BoundingBox box) -> BoundingSphere
        def self.CreateFromPoints: (Enumerable[Vector3] points) -> BoundingSphere
        def self.CreateFromFrustum: (BoundingFrustum frustum) -> BoundingSphere
        def Intersects: (BoundingBox box) -> bool
                        | (BoundingBox box) -> bool
                        | (BoundingFrustum frustum) -> bool
                        | (Plane plane) -> PlaneIntersectionType
                        | (Plane plane) -> PlaneIntersectionType
                        | (Ray ray) -> Float?
                        | (Ray ray) -> Float?
                        | (BoundingSphere sphere) -> bool
                        | (BoundingSphere sphere) -> bool
        def Contains: (BoundingBox box) -> ContainmentType
                      | (BoundingBox box) -> ContainmentType
                      | (BoundingFrustum frustum) -> ContainmentType
                      | (Vector3 point) -> ContainmentType
                      | (Vector3 point) -> ContainmentType
                      | (BoundingSphere sphere) -> ContainmentType
                      | (BoundingSphere sphere) -> ContainmentType
        def Transform: (Matrix matrix) -> BoundingSphere
                       | (Matrix matrix) -> BoundingSphere
        def ==: (BoundingSphere b) -> bool
        def !=: (BoundingSphere b) -> bool
      end

      class BoundingFrustum
        CornerCount: Integer
        def Near: () -> Plane
        def Far: () -> Plane
        def Left: () -> Plane
        def Right: () -> Plane
        def Top: () -> Plane
        def Bottom: () -> Plane
        def Matrix: () -> Matrix
        def Matrix=: (Matrix value) -> Matrix
        def initialize: (Matrix value) -> void
        def GetCorners: () -> Array[Vector3]
                        | (Array[Vector3] corners) -> nil
        def Equals: (BoundingFrustum other) -> bool
                    | (Object obj) -> bool
        def GetHashCode: () -> Integer
        def ToString: () -> String
        def Intersects: (BoundingBox box) -> bool
                        | (BoundingBox box) -> bool
                        | (BoundingFrustum frustum) -> bool
                        | (Plane plane) -> PlaneIntersectionType
                        | (Plane plane) -> PlaneIntersectionType
                        | (Ray ray) -> Float?
                        | (Ray ray) -> Float?
                        | (BoundingSphere sphere) -> bool
                        | (BoundingSphere sphere) -> bool
        def Contains: (BoundingBox box) -> ContainmentType
                      | (BoundingBox box) -> ContainmentType
                      | (BoundingFrustum frustum) -> ContainmentType
                      | (Vector3 point) -> ContainmentType
                      | (Vector3 point) -> ContainmentType
                      | (BoundingSphere sphere) -> ContainmentType
                      | (BoundingSphere sphere) -> ContainmentType
        def ==: (BoundingFrustum b) -> bool
        def !=: (BoundingFrustum b) -> bool
      end

      class ContainmentType
        Disjoint: ContainmentType
        Contains: ContainmentType
        Intersects: ContainmentType
      end

      class PlaneIntersectionType
        Front: PlaneIntersectionType
        Back: PlaneIntersectionType
        Intersecting: PlaneIntersectionType
      end

    end
  end
end
