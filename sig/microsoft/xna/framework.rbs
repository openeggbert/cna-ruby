module Microsoft
  module Xna
    module Framework
      class MathHelper
        def self.ToRadians: (Float degrees) -> Float
        def self.ToDegrees: (Float radians) -> Float
        def self.Distance: (Float value1, Float value2) -> Float
        def self.Min: (Float value1, Float value2) -> Float
        def self.Max: (Float value1, Float value2) -> Float
        def self.Clamp: (Float value, Float minimum, Float maximum) -> Float
        def self.Lerp: (Float value1, Float value2, Float amount) -> Float
        def self.WrapAngle: (Float angle) -> Float
      end

      class FrameworkDispatcher
        def self.Update: () -> nil
      end

      class Point
        attr_accessor X: Integer
        attr_accessor Y: Integer
        def initialize: () -> void
                      | (Integer x, Integer y) -> void
        def self.Zero: () -> Point
      end

      class GameComponentCollectionEventArgs < CNA::Runtime::EventArgs
        def initialize: (IGameComponent? gameComponent) -> void
        attr_reader GameComponent: IGameComponent?
      end

      class GameTime
        attr_reader TotalGameTime: Float
        attr_reader ElapsedGameTime: Float
        attr_reader IsRunningSlowly: bool
        def initialize: () -> void
                      | (Numeric total, Numeric elapsed) -> void
                      | (Numeric total, Numeric elapsed, bool running_slowly) -> void
      end

      class PlayerIndex
      end

      class DisplayOrientation
        Default: DisplayOrientation
        LandscapeLeft: DisplayOrientation
        LandscapeRight: DisplayOrientation
        Portrait: DisplayOrientation
        def |: (DisplayOrientation other) -> DisplayOrientation
        def &: (DisplayOrientation other) -> DisplayOrientation
      end

      # The first concrete component: pure managed, including both XNA contracts it implements.
      # The two CLR Dispose overloads project to one Ruby method dispatching on arity.
      class GameComponent
        include IGameComponent
        include IUpdateable

        def initialize: (Game? game) -> void
        def Game: () -> Game?
        def Enabled: () -> bool
        def Enabled=: (bool value) -> bool?
        def UpdateOrder: () -> Integer
        def UpdateOrder=: (Integer value) -> Integer?
        def Initialize: () -> nil
        def Update: (GameTime gameTime) -> nil
        def Dispose: (?bool disposing) -> nil
        def EnabledChanged: () -> CNA::Runtime::Event
        def UpdateOrderChanged: () -> CNA::Runtime::Event
        def Disposed: () -> CNA::Runtime::Event
      end

      # A sealed Collection<IGameComponent>. Its whole declared surface is four protected hooks
      # and two events; every public collection member arrives from CNA::Runtime::Collection.
      class GameComponentCollection < CNA::Runtime::Collection
        def initialize: () -> void
        def ComponentAdded: () -> CNA::Runtime::Event
        def ComponentRemoved: () -> CNA::Runtime::Event
      end

      # A Dictionary<string, string> whose whole public surface is inherited. Its constructor
      # parses ARGV with XNA's own rules: leading `/` and `-` trimmed, split on the first colon,
      # a colonless argument kept with an empty value, an empty key skipped, first occurrence wins.
      class LaunchParameters < CNA::Runtime::Dictionary
        def initialize: (?Array[String] arguments) -> void
      end

      # A façade over CNA's window, which has no handle of its own: every canonical route is
      # addressed through the game handle, so there is no second object and no second lifetime.
      # `new` is private because the CLR constructor is `assembly`.
      class GameWindow
        def Title: () -> String
        def Title=: (String value) -> String
        def Handle: () -> Integer
        def AllowUserResizing: () -> bool
        def AllowUserResizing=: (bool value) -> bool
        def ClientBounds: () -> Rectangle
        def ScreenDeviceName: () -> String
        def CurrentOrientation: () -> DisplayOrientation
        def BeginScreenDeviceChange: (bool willBeFullScreen) -> nil
        def EndScreenDeviceChange: (String screenDeviceName, ?Integer clientWidth, ?Integer clientHeight) -> nil
        def ScreenDeviceNameChanged: () -> CNA::Runtime::Event
        def ClientSizeChanged: () -> CNA::Runtime::Event
        def OrientationChanged: () -> CNA::Runtime::Event
      end

      class Game
        attr_reader GraphicsDevice: Graphics::GraphicsDevice?
        def initialize: () -> void
        def Run: () -> nil
        def RunOneFrame: () -> nil
        # A different XNA operation, not an alias: RunOneFrame is the host frame, Tick is the frame
        # step it wraps. After Exit the CLR latch makes it a permanent no-op.
        def Tick: () -> nil
        def Exit: () -> nil
        # Both forward to the timing loop CNA owns. SuppressDraw before the host exists is a
        # pending request delivered at creation; ResetElapsedTime is then genuinely a no-op.
        def SuppressDraw: () -> nil
        def ResetElapsedTime: () -> nil
        # The two CLR overloads project to one Ruby method dispatching on arity, which widens
        # the protected one to public -- a recorded mapping limitation Ruby cannot avoid.
        def Dispose: (?bool disposing) -> nil
        def Finalize: () -> nil
        # host?.ShowMissingRequirementMessage(e) ?? false; GameHost's own body is an
        # unconditional false and CNA is not WindowsGameHost.
        def ShowMissingRequirementMessage: (Exception exception) -> bool
        # Both answer the same object for the life of the Game, and neither needs a native host.
        def Components: () -> GameComponentCollection
        # The exact XNA expression: isActive && !(GamerServicesDispatcher.IsInitialized &&
        # Guide.IsVisible), each term read from its own canonical CNA route.
        def IsActive: () -> bool
        # One `ldfld`: the same object for the life of the Game, created by the constructor.
        def LaunchParameters: () -> LaunchParameters
        # `host?.Window`; XNA's null branch is unreachable because its constructor makes the
        # host, so this completes that deferred step rather than exposing a nil XNA never shows.
        def Window: () -> GameWindow
        def Services: () -> GameServiceContainer
        # The four canonical Game events. One CLR event, one Ruby reader over the subscription
        # primitive; the three protected raisers are the only public way to raise the first three,
        # and Dispose raises the fourth.
        # The four timing/presentation properties. Every getter is one `ldfld` in the pinned IL, so
        # each answers managed state and needs no host; the setters push down once one exists.
        # TimeSpan projects to Float seconds, which is the established BCL mapping.
        attr_reader IsFixedTimeStep: bool
        attr_reader TargetElapsedTime: Float
        attr_reader InactiveSleepTime: Float
        attr_reader IsMouseVisible: bool
        def IsFixedTimeStep=: (bool value) -> bool
        def TargetElapsedTime=: (Numeric value) -> Float
        def InactiveSleepTime=: (Numeric value) -> Float
        def IsMouseVisible=: (bool value) -> bool
        def Activated: () -> CNA::Runtime::Event
        def Deactivated: () -> CNA::Runtime::Event
        def Exiting: () -> CNA::Runtime::Event
        def Disposed: () -> CNA::Runtime::Event
      end

      class GraphicsDeviceManager
        DefaultBackBufferWidth: Integer
        DefaultBackBufferHeight: Integer
        attr_reader GraphicsDevice: Graphics::GraphicsDevice?
        def initialize: (Game game) -> void
        def DeviceCreated: () -> CNA::Runtime::Event
        def DeviceDisposing: () -> CNA::Runtime::Event
        def DeviceReset: () -> CNA::Runtime::Event
        def DeviceResetting: () -> CNA::Runtime::Event
        def Disposed: () -> CNA::Runtime::Event
        def Dispose: (?bool disposing) -> nil
      end

      # System.Type projects to a Ruby Module, which is what a service key is here.
      class GameServiceContainer
        def initialize: () -> void
        def AddService: (Module type, Object provider) -> nil
        def RemoveService: (Module type) -> nil
        def GetService: (Module type) -> Object?
      end
    end
  end
end
