module Microsoft
  module Xna
    module Framework
      module Media
        # Five get-only properties, each one `ldfld`. Construction is private because the CLR
        # constructor is `assembly`; nothing in this binding produces one.
        class Video
          attr_reader Duration: Float
          attr_reader Width: Integer
          attr_reader Height: Integer
          attr_reader FramesPerSecond: Float
          attr_reader VideoSoundtrackType: VideoSoundtrackType
        end

        # A public parameterless constructor allocating two 256-element float arrays, each wrapped
        # in a live ReadOnlyCollection view. Nothing in this binding fills them.
        class VisualizationData
          class FloatCollection < CNA::Runtime::ReadOnlyCollection
          end

          def initialize: () -> void
          attr_reader Frequencies: FloatCollection
          attr_reader Samples: FloatCollection
        end

        class MediaState
          Paused: MediaState
          Playing: MediaState
          Stopped: MediaState
        end

        class MediaSourceType
          LocalDevice: MediaSourceType
          WindowsMediaConnect: MediaSourceType
        end

        class VideoSoundtrackType
          Music: VideoSoundtrackType
          Dialog: VideoSoundtrackType
          MusicAndDialog: VideoSoundtrackType
        end

        class VideoPlayer
          def initialize: () -> void
          def Dispose: (?bool disposing) -> nil
          attr_reader IsDisposed: bool
          def GetTexture: () -> Microsoft::Xna::Framework::Graphics::Texture2D
          def Play: (Video video) -> nil
          def Pause: () -> nil
          def Resume: () -> nil
          def Stop: () -> nil
          def Video: () -> Video?
          def State: () -> MediaState
          def PlayPosition: () -> Float
          def IsLooped: () -> bool
          def IsLooped=: (bool value) -> bool
          def IsMuted: () -> bool
          def IsMuted=: (bool value) -> bool
          def Volume: () -> Float
          def Volume=: (Float | Integer value) -> Float
        end
      end
    end
  end
end
