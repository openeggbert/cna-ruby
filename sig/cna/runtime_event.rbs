module CNA
  module Runtime
    # The Ruby projection of System.EventArgs: the parameterless constructor and the shared
    # static Empty instance, and nothing else.
    class EventArgs
      Empty: EventArgs
    end

    # The generic event subscription primitive. One CLR public event projects to one Ruby event
    # reader returning this object; raising stays internal to the declaring implementation.
    class Event
      def add: (?untyped callable) ?{ (untyped sender, untyped args) -> void } -> untyped
      def remove: (untyped handler) -> untyped
    end

    # The Ruby projection of System.Attribute: a marker base with no members of its own.
    class Attribute
    end

    # The Ruby projection of System.Collections.ObjectModel.ReadOnlyCollection`1: a live view over
    # the backing Array it is constructed with, never a frozen copy, with no mutating member.
    class ReadOnlyCollection
      include ::Enumerable[untyped]

      CLR_IDENTITY: String
      CLR_SURFACE: Array[Symbol]
      CLR_PROTECTED_SURFACE: Array[Symbol]
      LANGUAGE_SUPPORT: Array[Symbol]

      def self.projects_elements: (*String) -> Array[String]
      def self.clr_element_types: () -> Array[String]?

      def initialize: (Array[untyped] list) -> void
      def Count: () -> Integer
      def []: (Integer index) -> untyped
      def Contains: (untyped value) -> bool
      def IndexOf: (untyped value) -> Integer
      def CopyTo: (Array[untyped] array, Integer array_index) -> nil
      def GetEnumerator: () -> Enumerator[untyped, untyped]
      def each: () { (untyped) -> void } -> ReadOnlyCollection
              | () -> Enumerator[untyped, untyped]
    end

    # The Ruby projection of System.Collections.ObjectModel.Collection`1: the mutable sibling of
    # the class above, a live view over the backing Array whose every mutation runs through one of
    # four protected hooks. No Ruby-idiomatic mutation exists beside the CLR surface.
    class Collection
      include ::Enumerable[untyped]

      CLR_IDENTITY: String
      CLR_SURFACE: Array[Symbol]
      CLR_PROTECTED_SURFACE: Array[Symbol]
      LANGUAGE_SUPPORT: Array[Symbol]

      def self.projects_elements: (*String) -> Array[String]
      def self.clr_element_types: () -> Array[String]?

      def initialize: (?Array[untyped] list) -> void
      def Count: () -> Integer
      def []: (Integer index) -> untyped
      def []=: (Integer index, untyped value) -> untyped
      def Add: (untyped item) -> nil
      def Clear: () -> nil
      def Contains: (untyped item) -> bool
      def CopyTo: (Array[untyped] array, Integer index) -> nil
      def GetEnumerator: () -> Enumerator[untyped, untyped]
      def IndexOf: (untyped item) -> Integer
      def Insert: (Integer index, untyped item) -> nil
      def Remove: (untyped item) -> bool
      def RemoveAt: (Integer index) -> nil
      def each: () { (untyped) -> void } -> Collection
              | () -> Enumerator[untyped, untyped]
    end

    # The measured register of non-XNA CLR identities this binding projects.
    module BclProjection
      TYPES: Hash[String, String]
      EXCEPTION_BASES: Hash[String, String]
      def self?.ruby_type: (String?) -> String?
      def self?.exception_base?: (String?) -> bool
      def self?.identities: () -> Array[String]
      def self?.definition: (String?) -> String
      def self?.element_types: (String?) -> Array[String]
      def self?.generic_projection?: (String?) -> bool
      THROWN_EXCEPTIONS: Hash[String, String]
      def self?.thrown_identities: () -> Array[String]
      def self?.thrown_exception: (String?) -> String?
    end

    # The Ruby projection of System.NotSupportedException: a real StandardError subclass, never
    # NotImplementedError, which is a ScriptError a bare rescue does not catch.
    class NotSupportedError < ::StandardError
      def initialize: (?String? message, ?::Exception? inner) -> void
    end

    # Shared construction for the projected XNA exception types.
    module ExceptionSupport
      def self?.bind_cause: (::Exception exception, ::Exception inner) -> ::Exception
    end

    module XnaExceptionConstruction
      def initialize: (?String? message, ?::Exception? inner) -> void
    end

    module EventOwner
      def xna_event: (Symbol identity) -> void
      def xna_abstract_event: (Symbol identity, String contract) -> void
      def xna_event_identities: () -> Array[Symbol]
    end
  end
end
